# Application Environment Configuration
APP_NAME="Adaptive Skill Gap Predictor (ASGP)"
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite:///./data/asgp.db"

# Data Directories
DATA_RAW_DIR="./data/raw"
DATA_PROCESSED_DIR="./data/processed"
DATA_SYNTHETIC_DIR="./data/synthetic"
MODELS_DIR="./models"
REPORTS_DIR="./reports"
EXPERIMENTS_DIR="./experiments"

# ML & Simulation Settings
DEFAULT_RANDOM_SEED=42
READINESS_TARGET=0.80
DEFAULT_TRAINING_BUDGET=50
